# Copy to .env — defaults match docker-compose.yml.

# Postgres (docker compose maps it to host port 5433).
# Runtime role: RLS applies. Owner role: migrations and seed wipes only.
DATABASE_URL=postgres://realestate_app:app@localhost:5433/realestate
DATABASE_OWNER_URL=postgres://realestate_owner:owner@localhost:5433/realestate

# Auth — generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# S3-compatible storage (SeaweedFS locally)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=realestate
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey

# SMTP (Mailpit locally — UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="PRODUCT_NAME <no-reply@example.test>"

# Key of the secrets stored per organization (SATIM password, WhatsApp token), base64 of 32 bytes.
# Optional locally (derived from BETTER_AUTH_SECRET); set your own in production, same command as above.
# SECRETS_KEY=

# Local stand-ins of SATIM and the WhatsApp Cloud API (/api/dev/*): on by default outside production.
# With real SATIM test credentials: DEV_GATEWAYS=false (or SATIM_TEST_URL=https://test.satim.dz/payment/rest).
# DEV_GATEWAYS=true
# SATIM_TEST_URL=
# SATIM_PRODUCTION_URL=https://cib.satim.dz/payment/rest
# WhatsApp Cloud API (Meta Graph API with its version); the stand-in by default when DEV_GATEWAYS is on.
# WHATSAPP_API_URL=https://graph.facebook.com/v23.0
